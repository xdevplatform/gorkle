# Copy to .env and fill in. Never commit .env.

# OAuth2 user-context token for @PlayGrokkle (dm.read dm.write tweet.read users.read media.write)
X_ACCESS_TOKEN=

# Numeric user id for @PlayGrokkle
CHAT_BOT_USER_ID=2089844175688597504

# Juicebox PIN used when the Chat identity was created
CHAT_PIN=

# public_key_version from the registered X Chat identity
CHAT_SIGNING_KEY_VERSION=

# public_key_fingerprint from registration (optional sanity check)
CHAT_FINGERPRINT=

# Optional: base64 export_keys blob. If set, used instead of CHAT_PIN.
CHAT_PRIVATE_KEYS_B64=

# xAI API key. Pick (once a day) can be a reasoning model; answers should not.
XAI_API_KEY=
XAI_MODEL=grok-4.3
XAI_ANSWER_MODEL=grok-4.20-0309-non-reasoning
XAI_IMAGINE_MODEL=grok-imagine-image-2.0

# US trending topics. Worldwide is 1.
TRENDS_WOEID=23424977

# Poll interval for the inbox (seconds)
POLL_INTERVAL=4

# People who DM @PlayGrokkle without following land in Message requests.
# GET /2/chat/conversations does not list those. Comma-separated handles or numeric ids
# are looked up with GET /2/chat/conversations/{id}, which still works for request threads.
CHAT_PEER_USER_IDS=

# App-only Bearer token (developer portal → app keys). Required to discover
# Message-request DMs from people who don't follow the bot.
# The X_ACCESS_TOKEN user/chat-bot token cannot call GET /2/activity/stream.
X_BEARER_TOKEN=

# Optional Postgres (Replit SQL Database sets DATABASE_URL automatically).
# If unset, local SQLite at data/groks_secret.sqlite is used.
# DATABASE_URL=

# Concurrent Grok replies (one thread per in-flight player). Health checks bind PORT.
WORKERS=16
# PORT=8080

